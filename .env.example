# --- Обязательные ---
# Подпись сессий (JWT) И шифрование паролей внешних БД (Database Connections,
# abkit/db_connections/crypto.py — ключ Fernet выводится из этого же секрета,
# отдельного ABKIT_DB_ENCRYPTION_KEY нет). Генерировать: openssl rand -hex 32.
# ВНИМАНИЕ: ротация этого ключа делает уже сохраненные пароли подключений к
# БД нерасшифровываемыми — прежде чем менять его, пересоздайте подключения
# (Settings > Database Connections) или временно сохраните старое значение.
ABKIT_SECRET_KEY=change-me-long-random-string
POSTGRES_PASSWORD=change-me

# --- С разумными дефолтами ---
POSTGRES_USER=abkit
POSTGRES_DB=abkit
# DATABASE_URL собирается автоматически в docker-compose.yml из POSTGRES_USER/
# POSTGRES_PASSWORD/POSTGRES_DB (docker-compose .env не раскрывает ${...}
# внутри своих же значений — задавать тут DATABASE_URL напрямую бесполезно).
# Если нужен внешний managed Postgres — переопределите переменную DATABASE_URL
# в environment: сервиса backend в docker-compose.yml.
ABKIT_PORT=8080                         # внешний порт nginx
ABKIT_LOG_LEVEL=INFO
ABKIT_LOG_FORMAT=json                   # json | text
ABKIT_SESSION_LIFETIME_HOURS=72
# Потолок и для загрузки датасета, и для импорта эксперимента zip-архивом
# (один и тот же client_max_body_size в docker/nginx.conf.template): архив с
# включенными снапшотами датасетов может быть заметно больше самого датасета.
ABKIT_MAX_UPLOAD_MB=400
ABKIT_ALLOW_SELF_REGISTRATION=false     # как в Superset: по умолчанию учетки заводит админ

# --- Развертывание из внутреннего реестра (Harbor) ---
# Нужны ТОЛЬКО на прод-VM, которая тянет готовые образы и ничего не собирает
# (docs/OPERATIONS.md §2). На машине разработчика их не задают: обычный
# `docker compose up -d --build` собирает локально и про реестр не знает.
#
# ABKIT_REGISTRY — проект в Harbor, БЕЗ имени образа и без тега.
#ABKIT_REGISTRY=hb.intra.click.uz/abset
# ABKIT_VERSION — тег релиза, который развернут прямо сейчас. Именно эта
# строка (а не git checkout) определяет, что запущено: обновление и откат —
# это правка одной этой строки + pull + up (OPERATIONS §3/§4). Плавающий
# :latest тут НЕДОПУСТИМ — по нему нельзя сказать, что именно крутится.
#ABKIT_VERSION=v2.6.0
# Откуда брать postgres на машине без интернета — два варианта, см.
# комментарий в docker-compose.prod.yml (proxy cache Harbor либо ручное
# зеркало в тот же проект).
#ABKIT_POSTGRES_IMAGE=hb.intra.click.uz/dockerhub/library/postgres:16-alpine

# --- SSO: вход через корпоративный Keycloak (docs/OPERATIONS.md §6.1) ---
# ВСЁ опционально. Без ABKIT_OIDC_ENABLED=true вход по паролю работает ровно
# как раньше, кнопки SSO на странице логина нет. Парольный вход НЕ отключается
# и при включенном SSO — иначе недоступный Keycloak отрезал бы всех, включая
# админов (break-glass admin входит паролем всегда).
#ABKIT_OIDC_ENABLED=true
#ABKIT_OIDC_ISSUER=https://keycloak.intra.click.uz/realms/<realm>
#ABKIT_OIDC_CLIENT_ID=abset
#ABKIT_OIDC_CLIENT_SECRET=                # выдает админ Keycloak
#ABKIT_OIDC_ROLE_CLAIM=groups             # claim со списком групп в ID-токене
#ABKIT_OIDC_ROLE_MAP={"abset-admins":"admin","abset-editors":"editor","abset-viewers":"viewer"}
#ABKIT_OIDC_DEFAULT_ROLE=viewer           # ПУСТО = отклонять тех, кто не попал ни в одну группу
#ABKIT_OIDC_LOGOUT_UPSTREAM=false         # true — выход из ABSet ведет и на logout Keycloak
# ABKIT_PUBLIC_URL обязателен при включенном SSO: из него строится redirect_uri
# (из заголовков Host — НИКОГДА, см. abkit/auth/oidc.py). Должен побайтово
# совпадать с Valid redirect URI, зарегистрированным у клиента в Keycloak.
#ABKIT_PUBLIC_URL=https://abset.intra.click.uz
# Только для локальной разработки (docker-compose.keycloak.yml): внутренний
# адрес того же IdP для серверных вызовов. В проде ОСТАВИТЬ ПУСТЫМ.
#ABKIT_OIDC_INTERNAL_BASE_URL=

# --- Database Connections + датасеты из SQL (CLAUDE.md, "Database Connections
# + датасет-центричная модель") ---
ABKIT_SQL_MAX_ROWS=5000000              # обрезка датасета из SQL, с флагом truncated в UI
ABKIT_SQL_TIMEOUT_SEC=300               # таймаут выполнения SELECT (from-sql/refresh, не preview)
ABKIT_SQL_LAB_TIMEOUT_SEC=60            # отдельный, КОРОТКИЙ таймаут интерактивных прогонов в SQL Lab: за ними ждет живой человек, а не фоновая джоба (лимит строк — 1000, он не настраивается)

# --- Backend API (FRONTEND.md; сервисы backend/frontend в docker-compose.yml) ---
ABKIT_JOB_WORKERS=2                     # потоков ThreadPoolExecutor для design/analyze/validate (FRONTEND.md §4)
ABKIT_BACKEND_MEM_LIMIT=4g              # страховка от OOM на сервере, не признак известной утечки — см. OPERATIONS.md §"Память backend-процесса"
#ABKIT_COOKIE_SECURE=false               # true, только вместе с TLS-блоком в docker/nginx.conf.template (см. docker/README.md, раздел TLS) — иначе браузер Secure-cookie на голом HTTP не сохранит
#ABKIT_CORS_ORIGINS=http://localhost:5173 # ТОЛЬКО для локальной разработки фронта без Docker (vite dev server, npm run dev); не участвует в docker-compose (один origin через nginx, CORS не нужен)
#VITE_API_BASE=                         # аналогично — только для локальной разработки; в docker-compose не используется (frontend/src/api/client.ts по умолчанию ходит по относительному "/api/v1", один origin через nginx)

# --- Bootstrap первого администратора (опционально) ---
# Если заданы оба значения и таблица users пуста — entrypoint backend создаст
# первого админа автоматически при старте (без ручного docker compose exec).
# Иначе создайте его вручную: docker compose exec backend abkit-admin create-admin --email admin@co.com
#ABKIT_ADMIN_EMAIL=admin@company.com
#ABKIT_ADMIN_PASSWORD=change-me
#ABKIT_ADMIN_NAME=Admin
